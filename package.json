{
  "displayName": "UniFi Access Point Light",
  "name": "homebridge-unifi-ap-light",
  "version": "1.5.0",
  "description": "Control UniFi access point light rings from HomeKit.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pizzalorddex/homebridge-unifi-ap-light.git"
  },
  "bugs": {
    "url": "https://github.com/pizzalorddex/homebridge-unifi-ap-light/issues"
  },
  "homepage": "https://github.com/pizzalorddex/homebridge-unifi-ap-light#readme",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json",
    "docs/COMPATIBILITY.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint src tests vitest.config.ts --max-warnings=0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "verify": "npm run lint && npm run build && npm test",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build",
    "check:package": "npm run build && node scripts/check-package.mjs"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge-dynamic-platform",
    "homekit",
    "unifi",
    "access-point",
    "led",
    "udm",
    "udr"
  ],
  "dependencies": {
    "axios": "^1.20.0",
    "cookie": "^1.0.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.18",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.10.0",
    "hap-nodejs": "npm:@homebridge/hap-nodejs@^2.2.3",
    "homebridge": "^2.4.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "micromatch": {
      "picomatch": "2.3.2"
    }
  }
}
